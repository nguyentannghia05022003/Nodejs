{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "config/*": [
        "./src/config/*"
      ],
      "controllers/*": [
        "./src/controllers/*"
      ],
      "entities/*": [
        "./src/entities/*"
      ],
      "routes/*": [
        "./src/routes/*"
      ],
      "services/*": [
        "./src/services/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}